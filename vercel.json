{
  "version": 2,
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.7.2" }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/img/(.*)",
      "dest": "/public/img/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/img/logo.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}